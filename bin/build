#!/usr/bin/env bash
set -e

DIR=$( cd -- "$( dirname -- "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )
PROJ=$( cd -- "${DIR}/.." &> /dev/null && pwd )

pushd $PROJ/go
go mod tidy && go mod vendor
go test ./...
popd

pushd $PROJ/pulumi
go mod tidy && go mod vendor
go test -p 2 -gcflags="-c=2" ./...
popd
